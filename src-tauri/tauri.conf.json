{
  "productName": "phitodo",
  "version": "0.1.0",
  "identifier": "com.phitodo.app",
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.icns", "icons/icon.png", "icons/icon.ico"]
  },
  "build": {
    "beforeDevCommand": "vite dev",
    "beforeBuildCommand": "vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "phitodo",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ]
  }
}
